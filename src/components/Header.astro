---
import { site } from '../config';
import { getNavItems } from '../utils/pages';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const path = Astro.url.pathname;

// The four fixed sections plus any page she created and left in the menu.
const nav = await getNavItems();

const isActive = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href + '/'));
---

{/* The header carries no background of its own. It earns a blurred ground and a
    hairline once the page has scrolled beneath it (`data-scrolled`, set in
    enhance.ts), and condenses at the same time — so at rest it sits on the page
    rather than in a bar, and in motion it stays legible over whatever is
    passing under it.

    Over the landing hero it is `fixed`, so the navigation remains reachable all
    the way down a full-bleed first screen. Everywhere else `sticky` does the
    same job while still occupying its space in the flow, which is what the
    interior page headers are spaced against. */}
<header
  class:list={[
    'site-header z-50 w-full',
    transparent ? 'fixed top-0 left-0' : 'sticky top-0',
  ]}
>
  <div
    class="site-header-inner mx-auto flex max-w-[110rem] items-center justify-between px-(--spacing-gutter) py-6 md:py-8"
  >
    <a
      href="/"
      class="group flex flex-col leading-none focus-visible:outline-offset-8"
      aria-label={`${site.labNameShort} — home`}
    >
      <span
        class="font-display text-[1.35rem] tracking-[-0.02em] text-bone transition-colors duration-500 group-hover:text-clay-light md:text-[1.5rem]"
      >
        Social &amp; Affective Neuroscience
      </span>
      <span
        class="mt-1 text-eyebrow font-medium uppercase text-bone-muted"
      >
        Laboratory · UCLA
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-9">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative text-[0.95rem] tracking-wide transition-colors duration-400 hover:text-bone',
                  'after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-clay after:transition-all after:duration-500',
                  isActive(item.href)
                    ? 'text-bone after:w-full'
                    : 'text-bone-dim after:w-0 hover:after:w-full',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile: a details/summary disclosure. Works with zero JS. -->
    <details class="group relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 text-eyebrow font-medium uppercase text-bone-dim [&::-webkit-details-marker]:hidden"
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
        <svg
          width="18"
          height="12"
          viewBox="0 0 18 12"
          fill="none"
          aria-hidden="true"
          class="transition-transform duration-300 group-open:rotate-90"
        >
          <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
      </summary>
      <nav
        aria-label="Primary"
        class="nav-panel absolute right-0 z-50 mt-5 w-56 border border-bone/10 bg-ground-raised/95 p-2 shadow-2xl backdrop-blur-md"
      >
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'block px-4 py-3 text-[0.95rem] transition-colors hover:bg-bone/5 hover:text-bone',
                    isActive(item.href) ? 'text-clay-light' : 'text-bone-dim',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
