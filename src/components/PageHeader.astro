---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { splitWords } from '../utils/splitWords';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** Optional atmospheric image behind the title. */
  image?: ImageMetadata;
  imageAlt?: string;
}
const { eyebrow, title, lede, image, imageAlt } = Astro.props;

// Wrappers only — the heading text is untouched. See utils/splitWords.ts.
const titleHtml = splitWords(title);
---

<header class="relative overflow-hidden">
  {
    image && (
      <div class="absolute inset-0" aria-hidden={imageAlt ? undefined : 'true'}>
        {/* The picture drifts against the page as the header scrolls away. It
            carries a baseline scale so the travel has somewhere to go: at 1.1
            there is 5% of image beyond each edge, and the drift asks for 4% of
            it. Kept as low as the movement allows — every extra point of scale
            is a tighter crop on a composition that was chosen whole. */}
        <Image
          src={image}
          alt={imageAlt ?? ''}
          widths={[640, 1024, 1600, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover opacity-100"
          data-parallax
          style="--parallax-shift: 4%; --parallax-scale: 1.1"
        />
        {/* The type is left-aligned, so contrast is bought on the left only.
            Earlier passes dimmed the whole frame to protect a narrow column of
            text and left the picture looking washed out; these are weighted
            hard to the left and fade out well before the image's focal area. */}
        <div class="absolute inset-0 bg-gradient-to-r from-ground via-ground/55 via-30% to-transparent to-62%" />
        <div class="absolute inset-0 bg-gradient-to-t from-ground via-transparent to-ground/35" />
      </div>
    )
  }

  <div
    class:list={[
      'relative mx-auto max-w-[110rem] px-(--spacing-gutter)',
      image ? 'pb-24 pt-48 md:pb-32 md:pt-64' : 'pb-(--spacing-section) pt-40 md:pt-52',
    ]}
  >
    <p class="reveal text-eyebrow font-medium uppercase text-clay-light">{eyebrow}</p>
    <h1
      class="reveal-words mt-7 max-w-[18ch] font-display text-display text-bone"
      data-reveal-delay="110"
      set:html={titleHtml}
    />
    {
      lede && (
        <p
          class="reveal mt-9 max-w-(--container-prose) text-lede text-bone-dim"
          data-reveal-delay="380"
        >
          {lede}
        </p>
      )
    }
  </div>
</header>
