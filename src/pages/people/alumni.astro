---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Notice from '../../components/Notice.astro';

// Pulled from the current live site. Two groups: people who were listed as
// current lab members there and whom she asked to move to Alumni, and the
// people already on the Alumni list. Nobody has been dropped.
const alumni = (await getCollection('people'))
  .filter((p) => p.data.status === 'alumni')
  .sort((a, b) => a.data.order - b.data.order);

const moved = alumni.filter((p) => p.data.needsReview);
const established = alumni.filter((p) => !p.data.needsReview);
---

<Base
  title="Lab Alumni"
  description="Former members of the Social and Affective Neuroscience Laboratory at UCLA."
>
  <PageHeader eyebrow="People" title="Lab alumni" />

  <section class="mx-auto max-w-[110rem] px-(--spacing-gutter) pb-(--spacing-section)">
    <Notice title="One thing to confirm">
      <p>
        The {moved.length} people below marked as recently moved were listed as current
        lab members on the live site; she asked for everyone other than the six
        current members to be moved here. No current position was listed for
        them, so those entries carry no description yet.
      </p>
    </Notice>

    {
      moved.length > 0 && (
        <div class="mt-20">
          <h2 class="text-eyebrow font-medium uppercase text-clay-light">Recently moved</h2>
          <ul class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
            {moved.map((person) => (
              <li class="reveal border-b border-bone/12 pb-4">
                <span class="block font-display text-[1.2rem] text-bone">{person.data.name}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-24">
      <h2 class="text-eyebrow font-medium uppercase text-clay-light">Alumni</h2>
      <ul class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          established.map((person, i) => (
            <li class="reveal border-b border-bone/12 pb-5" data-reveal-delay={(i % 3) * 70}>
              <span class="block font-display text-[1.2rem] text-bone">{person.data.name}</span>
              <span class="mt-1.5 block text-[0.92rem] leading-relaxed text-bone-muted">
                {person.data.role}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-24">
      <a href="/people" class="link-rule text-[1.05rem]">← Current lab members</a>
    </p>
  </section>
</Base>
