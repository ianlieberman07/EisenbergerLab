---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonRow from '../../components/PersonRow.astro';
import Notice from '../../components/Notice.astro';

const people = (await getCollection('people'))
  .filter((p) => p.data.status === 'current')
  .sort((a, b) => a.data.order - b.data.order);

const missing = people.filter((p) => p.data.needsReview).map((p) => p.data.name);
---

<Base
  title="People"
  description="Current members of the Social and Affective Neuroscience Laboratory at UCLA."
>
  <PageHeader eyebrow="People" title="Lab members" />

  <section class="mx-auto max-w-[110rem] px-(--spacing-gutter) pb-(--spacing-section)">
    {
      missing.length > 0 && (
        <Notice title="Content outstanding">
          <p>
            No bio or photograph was supplied for {missing.join(', ')} — not in
            the brief and not in the Word document. Nothing has been written in
            their place.
          </p>
          <p>
            Job titles for the five lab members are also unconfirmed: the
            document lists them only under the heading "Lab members", so they all
            read as "Lab Member" until she confirms the real ones.
          </p>
        </Notice>
      )
    }

    <div class="mt-16 border-t border-bone/12">
      {people.map((person) => <PersonRow person={person} />)}
    </div>

    <p class="mt-20">
      <a href="/people/alumni" class="link-rule text-[1.05rem]">Lab alumni →</a>
    </p>
  </section>
</Base>
