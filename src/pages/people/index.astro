---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import Notice from '../../components/Notice.astro';

const people = (await getCollection('people'))
  .filter((p) => p.data.status === 'current')
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="People"
  description="Current members of the Social and Affective Neuroscience Laboratory at UCLA."
>
  <PageHeader eyebrow="People" title="Lab members" />

  <section class="mx-auto max-w-[110rem] px-(--spacing-gutter) pb-(--spacing-section)">
    <Notice title="Content outstanding">
      <p>
        Headshots have not been supplied for any current member — every card
        below is showing its initials fallback. Bios were not included in the
        repository either, and Erica Hornstein's bio and title were flagged as
        missing in the brief itself.
      </p>
    </Notice>

    <ul class="mt-20 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {
        people.map((person, i) => (
          <li class="reveal" data-reveal-delay={(i % 3) * 90}>
            <PersonCard person={person} />
          </li>
        ))
      }
    </ul>

    <p class="mt-24">
      <a href="/people/alumni" class="link-rule text-[1.05rem]">Lab alumni →</a>
    </p>
  </section>
</Base>
