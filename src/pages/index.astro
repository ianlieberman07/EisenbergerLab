---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../config';

// This is the existing cover image from the current site, which she approved
// keeping ("fine to leave the same image"). Verified byte-for-byte identical to
// sanlab-brain-cover.jpg served by sanlab.psych.ucla.edu, so it carries whatever
// licence the lab already holds rather than being a new pick.
import hero from '../assets/heroes/01-hands-forming-brain-bw.jpg';
// Chosen by the client to replace the tree/birds image.
import breakImage from '../assets/heroes/17-gears-heads-blue-red.jpg';

const topics = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={site.labNameShort}
  description="The Social and Affective Neuroscience Laboratory at UCLA, directed by Naomi Eisenberger, studies how social connection and disconnection shape the brain and the body."
  transparentHeader
>
  {/* Hero: the cover image full-bleed and centred, as before — but `contain`
      rather than `cover`, so the whole brain-of-hands is visible instead of
      being cropped down to a mass of fingers. `screen` blending drops the
      photograph's pure-black ground into the page's warm charcoal so there is
      no visible black box around it. */}
  {/* No `isolate` here: isolation would trap the blend in its own stacking
      context, leaving the photograph's black ground painting over the page
      instead of screening into it. */}
  <section class="relative min-h-[100svh] overflow-hidden">
    {/* `bg-ground` is load-bearing, not decoration: mix-blend-mode blends with
        its backdrop, and the body's background propagates to the viewport
        canvas, which is NOT part of the blending group. Without a painted
        backdrop here the photograph's black ground renders as a visible black
        rectangle instead of screening into the page. */}
    <div class="absolute inset-0 hidden bg-ground lg:block">
      <Image
        src={hero}
        alt="A brain formed from many interlocking human hands, photographed in black and white against a dark ground."
        widths={[800, 1200, 1800, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-contain object-center p-[7vh] mix-blend-screen"
      />
      {/* Only a whisper of a global scrim — anything heavier smothers the
           photograph. The type's contrast is handled by a local plate below. */}
      <div class="absolute inset-0 bg-gradient-to-r from-ground/80 via-transparent to-transparent">
      </div>
    </div>

    <div
      class="relative mx-auto flex min-h-[100svh] max-w-[110rem] flex-col justify-center gap-6 px-(--spacing-gutter) pb-14 pt-24"
    >
      {/* Small screens get the image inline instead of behind the type —
          overlaying it on a phone leaves neither the picture nor the words
          enough room. */}
      <div class="reveal bg-ground lg:hidden" data-reveal-delay="80">
        <Image
          src={hero}
          alt=""
          widths={[480, 800, 1200]}
          sizes="88vw"
          loading="eager"
          class="mx-auto max-h-[30svh] w-full object-contain mix-blend-screen"
        />
      </div>

      {/* Local contrast plate. The hero type sits over the brightest part of
          the photograph, where bone-on-hands falls well below WCAG AA. A
          gradient scoped to the text block fixes that without dimming the
          image the way a full-width scrim does. */}
      <div class="relative max-w-[46rem]">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -inset-x-10 -inset-y-8 hidden bg-gradient-to-r from-ground via-ground/90 to-transparent lg:block"
        >
        </div>

        <p class="reveal relative text-eyebrow font-medium uppercase text-clay-light">
          University of California, Los Angeles
        </p>

        <h1
          class="reveal relative mt-6 max-w-[15ch] font-display text-hero text-bone"
          data-reveal-delay="120"
        >
          Social &amp; Affective Neuroscience Laboratory
        </h1>

        <div class="reveal relative mt-8 border-t border-bone/15 pt-7" data-reveal-delay="240">
          <p class="text-lede text-bone-dim">
            Directed by <span class="text-bone">{site.director}</span>
          </p>

          <a
            href="/research"
            class="group mt-8 inline-flex items-center gap-3 text-eyebrow font-medium uppercase text-bone transition-colors duration-500 hover:text-clay-light"
          >
            Enter the site
            <span
              aria-hidden="true"
              class="inline-block h-px w-12 bg-clay transition-all duration-500 group-hover:w-20"
            ></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ THESIS ══ -->
  <section class="mx-auto max-w-[110rem] px-(--spacing-gutter) py-(--spacing-section)">
    <div class="grid gap-12 md:grid-cols-12">
      <p class="reveal text-eyebrow font-medium uppercase text-clay-light md:col-span-3">
        The question
      </p>
      <div class="md:col-span-9">
        {/* Her own words from the lab overview, turned from a clause into the
            direct question the section is labelled as. */}
        <h2 class="reveal max-w-[24ch] font-display text-display text-bone">
          Why do social relationships matter so profoundly for both mental and
          physical health?
        </h2>
        <p
          class="reveal mt-9 max-w-(--container-prose) text-lede text-bone-dim"
          data-reveal-delay="140"
        >
          Using a combination of neuroimaging, pharmacological, physiological,
          and behavioral methods, we trace the pathways that run in both
          directions between the social world and the body: how social
          experiences get under the skin to shape stress and immune responses,
          and how bodily states like inflammation reshape social experience in
          turn.
        </p>
        <p class="reveal mt-8" data-reveal-delay="220">
          <a href="/research" class="link-rule text-[1.05rem]">Read the lab overview</a>
        </p>
      </div>
    </div>
  </section>

  {/* Full-bleed break. Given its natural height rather than a fixed one, so
      both heads stay in frame — cropping it to a band cut the composition in
      half and left a hard seam. `screen` blending turns the artwork's black
      ground into the page's charcoal, so it dissolves into the page instead of
      sitting in a rectangle, and no scrim gradient is needed on top. */}
  <section class="relative overflow-hidden bg-ground">
    <Image
      src={breakImage}
      alt="Two facing head profiles built from interlocking gears — one warm orange, one red — with gears streaming through the air between them."
      widths={[640, 1024, 1600, 2600]}
      sizes="100vw"
      loading="lazy"
      class="h-auto w-full mix-blend-screen"
    />
  </section>

  <!-- ══ RESEARCH INDEX ══ -->
  <section class="mx-auto max-w-[110rem] px-(--spacing-gutter) py-(--spacing-section)">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="reveal text-eyebrow font-medium uppercase text-clay-light">Research</p>
        <h2 class="reveal mt-6 max-w-[18ch] font-display text-display text-bone">
          Four strands of inquiry
        </h2>
      </div>
      <a
        href="/research"
        class="reveal group inline-flex shrink-0 items-center gap-3 text-eyebrow font-medium uppercase text-bone-dim transition-colors duration-500 hover:text-bone"
      >
        All research
        <span
          aria-hidden="true"
          class="inline-block h-px w-10 bg-clay transition-all duration-500 group-hover:w-16"
        ></span>
      </a>
    </div>

    <ul class="mt-16 border-t border-bone/12">
      {
        topics.map((topic, i) => (
          <li class="reveal" data-reveal-delay={i * 90}>
            <a
              href={`/research/${topic.id}`}
              class="group flex items-baseline gap-6 border-b border-bone/12 py-9 transition-colors duration-500 hover:bg-bone/[0.03] md:gap-12 md:py-11"
            >
              <span class="w-8 shrink-0 font-display text-[0.95rem] text-clay-light md:w-12">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="flex-1 font-display text-title text-bone transition-colors duration-500 group-hover:text-clay-light">
                {topic.data.title}
              </span>
              <span
                aria-hidden="true"
                class="hidden h-px w-10 shrink-0 self-center bg-bone/25 transition-all duration-500 group-hover:w-20 group-hover:bg-clay md:block"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
