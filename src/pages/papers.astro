---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import headerImage from '../assets/heroes/06-maze-brain-head-black.jpg';

// Transcribed from her CV (June 2026). Sorted newest first, with "in press"
// entries — stored as year 9999 so they sort to the top — shown first.
const papers = (await getCollection('papers')).sort(
  (a, b) => b.data.year - a.data.year || b.data.id - a.data.id
);

const years = [...new Set(papers.map((p) => p.data.year))]
  .filter((y) => y !== 9999)
  .sort((a, b) => b - a);

// Decade buckets keep the filter bar to a readable width — 27 individual year
// buttons would be worse than no filter at all.
const decades = [...new Set(years.map((y) => Math.floor(y / 10) * 10))].sort((a, b) => b - a);

const total = papers.length;
const inPressCount = papers.filter((p) => p.data.inPress).length;
const freeCount = papers.filter((p) => p.data.openAccess).length;

const scholar = (title: string) =>
  `https://scholar.google.com/scholar?q=${encodeURIComponent(title)}`;
---

<Base
  title="Papers"
  description={`${total} publications from the Social and Affective Neuroscience Laboratory at UCLA, directed by Naomi Eisenberger.`}
>
  <PageHeader
    image={headerImage}
    imageAlt="A white sculpted head, open at the crown to reveal a maze in place of a brain."
    eyebrow="Publications"
    title="Papers"
  />

  <section class="mx-auto max-w-[110rem] px-(--spacing-gutter) pb-(--spacing-section)">
    <!-- Controls. Without JS the search and filters are hidden (they would do
         nothing) and the full list renders as a plain, complete bibliography.

         Sticky beneath the header: this is a 200-entry bibliography, and a
         filter bar that scrolls away is a filter bar you have to scroll back up
         to. `--spacing-header` is the header's measured height, published by
         enhance.ts, so the two edges meet exactly. -->
    <div
      id="paper-controls"
      class="sticky top-(--spacing-header) z-30 hidden -mx-(--spacing-gutter) border-y border-bone/12 bg-ground/85 px-(--spacing-gutter) py-6 backdrop-blur-xl"
    >
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <label class="relative block w-full lg:max-w-md">
          <span class="sr-only">Search publications</span>
          <input
            type="search"
            id="paper-search"
            placeholder="Search title, author, or journal…"
            autocomplete="off"
            class="w-full border-b border-bone/25 bg-transparent py-3 pr-9 text-[1rem] text-bone placeholder:text-bone-muted focus:border-clay focus:outline-none"
          />
          <svg
            class="pointer-events-none absolute right-1 top-1/2 -translate-y-1/2 text-bone-muted"
            width="17"
            height="17"
            viewBox="0 0 17 17"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="7" cy="7" r="5.4" stroke="currentColor" stroke-width="1.3"></circle>
            <path d="M11 11l4.5 4.5" stroke="currentColor" stroke-width="1.3"></path>
          </svg>
        </label>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <span class="text-eyebrow font-medium uppercase text-clay-light">Period</span>
          <button type="button" data-decade="all" class="filter-chip is-active">All</button>
          {
            inPressCount > 0 && (
              <button type="button" data-decade="inpress" class="filter-chip">
                In press
              </button>
            )
          }
          {
            decades.map((d) => (
              <button type="button" data-decade={String(d)} class="filter-chip">
                {d}s
              </button>
            ))
          }
        </div>

        {/* Two thirds of the list can be read without a subscription, which is
            worth being able to isolate. */}
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <span class="text-eyebrow font-medium uppercase text-clay-light">Access</span>
          <button type="button" id="free-toggle" class="filter-chip">
            Free to read ({freeCount})
          </button>
        </div>
      </div>

      <p id="paper-count" class="mt-5 text-[0.88rem] text-bone-muted" aria-live="polite">
        Showing all {total} publications
      </p>
    </div>

    <ol id="paper-list" class="mt-4">
      {
        papers.map((paper) => (
          <li
            class="paper-item -mx-4 border-b border-bone/12 px-4 py-8"
            data-year={paper.data.year}
            data-decade={paper.data.inPress ? 'inpress' : String(Math.floor(paper.data.year / 10) * 10)}
            data-free={paper.data.openAccess ? 'yes' : 'no'}
            data-search={`${paper.data.title} ${paper.data.authors} ${paper.data.journal}`.toLowerCase()}
          >
            <div class="flex flex-col gap-2 sm:flex-row sm:gap-8">
              <span class="paper-year shrink-0 pt-0.5 font-display text-[0.95rem] text-clay-light sm:w-20">
                {paper.data.inPress ? 'In press' : paper.data.year}
              </span>

              <div class="flex-1">
                <h2 class="font-display text-[1.22rem] leading-snug text-bone">
                  {paper.data.title}
                </h2>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-bone-muted">
                  {paper.data.authors}
                </p>
                {paper.data.journal && (
                  <p class="mt-1 text-[0.95rem] italic leading-relaxed text-bone-dim">
                    {paper.data.journal}
                  </p>
                )}

                <p class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-1 text-[0.85rem]">
                  {
                    paper.data.doi && (
                      <a
                        href={paper.data.doi}
                        rel="noopener"
                        class="text-clay-light underline-offset-4 hover:text-bone hover:underline"
                      >
                        {/* When the publisher's own page is the free copy, say so
                            here rather than printing the same URL twice under a
                            second "free" label. */}
                        {paper.data.openAccess && !paper.data.pdf
                          ? 'Read it free ↗'
                          : 'Publisher ↗'}
                      </a>
                    )
                  }
                  {/* Only ever an open-access copy, and only after the link was
                      verified to respond — never a paywalled publisher PDF. */}
                  {
                    paper.data.pdf && (
                      <a
                        href={paper.data.pdf}
                        rel="noopener"
                        class="text-clay-light underline-offset-4 hover:text-bone hover:underline"
                      >
                        Read it free ↗
                      </a>
                    )
                  }
                  {
                    !paper.data.doi && (
                      <a
                        href={scholar(paper.data.title)}
                        rel="noopener"
                        target="_blank"
                        class="text-bone-muted underline-offset-4 hover:text-clay-light hover:underline"
                      >
                        Search for this paper ↗
                      </a>
                    )
                  }
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p id="paper-empty" class="hidden py-16 text-lede text-bone-muted">
      No publications match that search.
    </p>
  </section>
</Base>

<style>
  /* The active rule is a pseudo-element scaled on the x axis rather than a
     border colour swap, so selecting a period reads as the underline sliding
     open under the word. */
  .filter-chip {
    position: relative;
    font-size: 0.92rem;
    color: var(--color-bone-muted);
    padding-bottom: 0.3rem;
    cursor: pointer;
    transition: color 0.35s var(--ease-out-soft);
  }
  .filter-chip::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--color-clay);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.45s var(--ease-out-expo);
  }
  .filter-chip:hover {
    color: var(--color-bone);
  }
  .filter-chip:hover::after {
    transform: scaleX(1);
    background: rgb(242 239 233 / 0.3);
  }
  .filter-chip.is-active {
    color: var(--color-bone);
  }
  .filter-chip.is-active::after {
    transform: scaleX(1);
    background: var(--color-clay);
  }

  .paper-item {
    transition: background-color 0.45s var(--ease-out-soft);
  }
  .paper-item:hover {
    background-color: rgb(242 239 233 / 0.025);
  }
  .paper-item:hover .paper-year {
    color: var(--color-bone);
  }
  .paper-year {
    transition: color 0.45s var(--ease-out-soft);
  }

  /* Applied to the leading run of results after a filter changes, so the new
     set arrives rather than blinking into place. Only the first rows are
     staggered — nobody sees row 90 animate, and 200 staggered animations would
     be a long, pointless wait. */
  html.js .paper-item--enter {
    animation: paper-in 0.5s var(--ease-out-soft) both;
    animation-delay: calc(var(--n, 0) * 22ms);
  }
  @keyframes paper-in {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .paper-item--enter {
      animation: none;
    }
  }
</style>

<script>
  // How many of the leading results get the staggered entrance. Beyond this the
  // rows are off screen anyway, and animating all 200 would mean waiting four
  // seconds for a filter to finish.
  const STAGGER_LIMIT = 12;

  function setupPapers() {
    // Progressive enhancement: the controls are hidden by default in the markup
    // and only revealed here, so a no-JS visitor gets the complete list rather
    // than a search box that does nothing.
    const controls = document.getElementById('paper-controls');
    const search = document.getElementById('paper-search') as HTMLInputElement | null;
    const countEl = document.getElementById('paper-count');
    const emptyEl = document.getElementById('paper-empty');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.paper-item'));
    if (!controls || !search || !countEl || !emptyEl || !items.length) return;

    controls.classList.remove('hidden');

    let decade = 'all';
    let query = '';
    let freeOnly = false;

    const apply = (animate: boolean) => {
      let shown = 0;
      for (const item of items) {
        const matchesDecade = decade === 'all' || item.dataset.decade === decade;
        const matchesQuery = !query || (item.dataset.search ?? '').includes(query);
        const matchesFree = !freeOnly || item.dataset.free === 'yes';
        const visible = matchesDecade && matchesQuery && matchesFree;

        item.hidden = !visible;
        item.classList.remove('paper-item--enter');
        if (visible && animate && shown < STAGGER_LIMIT) {
          item.style.setProperty('--n', String(shown));
          // Reading a layout property flushes the class removal above, so the
          // animation restarts on a filter change instead of being seen as the
          // same one still running.
          void item.offsetWidth;
          item.classList.add('paper-item--enter');
        }
        if (visible) shown++;
      }

      emptyEl.classList.toggle('hidden', shown > 0);
      countEl.textContent =
        shown === items.length
          ? `Showing all ${items.length} publications`
          : `Showing ${shown} of ${items.length} publications`;
    };

    let timer: number;
    search.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        query = search.value.trim().toLowerCase();
        // No stagger while typing: re-running it on every keystroke turns the
        // list into a strobe.
        apply(false);
      }, 120);
    });

    const freeBtn = document.getElementById('free-toggle');
    freeBtn?.addEventListener('click', () => {
      freeOnly = !freeOnly;
      freeBtn.classList.toggle('is-active', freeOnly);
      freeBtn.setAttribute('aria-pressed', String(freeOnly));
      apply(true);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-decade]').forEach((btn) => {
      btn.addEventListener('click', () => {
        decade = btn.dataset.decade ?? 'all';
        document
          .querySelectorAll('[data-decade]')
          .forEach((b) => b.classList.toggle('is-active', b === btn));
        apply(true);
      });
    });
  }

  // The router swaps documents without re-running module scripts, so this has
  // to re-bind per page rather than once per session.
  document.addEventListener('astro:page-load', setupPapers);
</script>
