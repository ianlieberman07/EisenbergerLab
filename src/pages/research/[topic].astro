---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Notice from '../../components/Notice.astro';

// PLACEHOLDER IMAGE — Shutterstock, unlicensed. Each topic page is meant to get
// its own hero in the house style; this stands in until licensed art is chosen.
import fallbackHero from '../../assets/heroes/08-head-ladder-into-mind.jpg';

export const getStaticPaths = (async () => {
  const topics = await getCollection('research');
  return topics.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}) satisfies GetStaticPaths;

const { topic } = Astro.props;
const { Content } = await render(topic);
const hero = topic.data.hero ?? fallbackHero;
---

<Base
  title={topic.data.title}
  description={`${topic.data.title} — research in the Social and Affective Neuroscience Laboratory at UCLA.`}
>
  <PageHeader eyebrow="Research" title={topic.data.title} />

  <section class="relative mb-(--spacing-section) h-[42svh] min-h-[300px] overflow-hidden md:h-[62svh]">
    <Image
      src={hero}
      alt={topic.data.heroAlt ??
        'A sage-green sculpted head with a ladder leading up into the open skull.'}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="lazy"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ground via-transparent to-transparent"></div>
  </section>

  <section class="mx-auto max-w-[110rem] px-(--spacing-gutter) pb-(--spacing-section)">
    {
      topic.data.needsReview && (
        <Notice title="Awaiting client copy">
          <p>
            The approved text for this topic was not included in the repository.
            Per the brief it must be transcribed exactly, preserving her
            emphasis — so nothing has been written in its place.
          </p>
        </Notice>
      )
    }

    {/* While a topic is awaiting copy the Notice above says so; rendering the
        markdown too would just repeat it. Once the real text lands and
        needsReview flips to false, the copy renders on its own. */}
    {
      !topic.data.needsReview && (
        <div class="prose-lab max-w-(--container-prose)">
          <Content />
        </div>
      )
    }

    <p class="mt-20">
      <a href="/research" class="link-rule text-[1.05rem]">← All research</a>
    </p>
  </section>
</Base>
