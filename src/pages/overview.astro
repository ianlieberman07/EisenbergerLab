---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config';

// PLACEHOLDER IMAGE — Shutterstock, unlicensed. See DOCS/QUESTIONS.md #3.
import portrait from '../assets/heroes/12-paired-hollow-heads-pastel.jpg';

// Her approved lab overview, transcribed verbatim from Information for Website.docx.
const overview = await getEntry('pages', 'lab-overview');
const { Content } = await render(overview!);

const { contact } = site;
---

<Base
  title="Overview"
  description="An overview of the Social and Affective Neuroscience Laboratory at UCLA, directed by Naomi Eisenberger."
>
  <PageHeader eyebrow="Overview" title="The laboratory" />

  <section class="mx-auto max-w-[110rem] px-(--spacing-gutter) pb-(--spacing-section)">
    <div class="grid gap-16 md:grid-cols-12 md:gap-20">
      <div class="reveal md:col-span-7">
        <div class="prose-lab max-w-(--container-prose)">
          <Content />
        </div>
      </div>

      <aside class="md:col-span-5">
        <div class="sticky top-32">
          <Image
            src={portrait}
            alt="Two hollow sculpted heads on a pale plinth, faces opening toward one another, in dusty rose and sage against black."
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 40vw, 100vw"
            loading="lazy"
            class="w-full object-cover"
          />

          <div class="mt-12 border-t border-bone/12 pt-8">
            <h2 class="text-eyebrow font-medium uppercase text-clay-light">Contact</h2>
            <address class="mt-6 space-y-1 text-[1rem] not-italic leading-relaxed text-bone-dim">
              {contact.addressLines.map((line) => <div>{line}</div>)}
            </address>
            <dl class="mt-6 space-y-2 text-[1rem] text-bone-dim">
              <div class="flex gap-3">
                <dt class="text-bone-muted">Email</dt>
                <dd>{contact.email}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="text-bone-muted">Phone</dt>
                <dd>{contact.phone}</dd>
              </div>
            </dl>
            <p class="mt-6 text-[0.85rem] leading-relaxed text-clay-light">
              Address corrected to 5514 Pritzker Hall per the client. Phone,
              email and mail code still require confirmation.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>
