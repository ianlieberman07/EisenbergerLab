---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';

interface Props {
  title: string;
  description: string;
  /** Landing page overlays the header on a full-bleed image. */
  transparentHeader?: boolean;
}

const { title, description, transparentHeader = false } = Astro.props;

const pageTitle =
  title === site.labNameShort
    ? `${site.labName} — UCLA`
    : `${title} — ${site.labNameShort}, UCLA`;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Sitewide share image: the licensed cover photograph, cropped to the standard
// 1200×630. Absolute URL — scrapers ignore relative og:image paths.
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A brain formed from many interlocking human hands, in black and white."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#121110" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Set before paint so reveal elements never flash in, but only when JS
         is actually available. Without JS the .reveal rule leaves content visible. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {/* Drives the dev-only outlining of unapproved placeholder copy. */}
    {import.meta.env.DEV && <script is:inline>document.documentElement.dataset.env = 'dev';</script>}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Gentle fade/rise on scroll. Decoration only — nothing here is required
      // to read the page, and it is disabled under prefers-reduced-motion.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        // Anything already on screen at load reveals straight away. The
        // observer below deliberately ignores the bottom 12% of the viewport so
        // that content further down animates as it is scrolled to — but that
        // dead zone also covers the foot of the first screen, which left the
        // director's name invisible until the visitor scrolled. Content within
        // the first screen must never wait for a scroll that may never come.
        const pending: HTMLElement[] = [];
        items.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            const delay = Number(el.dataset.revealDelay ?? 0);
            window.setTimeout(() => el.classList.add('is-visible'), delay);
          } else {
            pending.push(el);
          }
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const delay = Number(el.dataset.revealDelay ?? 0);
              window.setTimeout(() => el.classList.add('is-visible'), delay);
              observer.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );
        pending.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
